---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import HistTable from '../components/HistTable.astro';
import { CODABENCH_GLOBAL_URL, CODABENCH_LOCAL_URL, GITHUB_REPO, LIVE_RESULTS_REL, withBase } from '../config';
import y2022 from '../data/results/2022.json';
import y2023 from '../data/results/2023.json';
import y2024 from '../data/results/2024.json';
import y2025 from '../data/results/2025.json';

// Prior editions (2022–2025), rendered faithfully from committed JSON — each
// keeps its own structure. 2026 is the current edition: its final results are
// committed (participant_results.json); the live CodaBench snapshot is only
// used while that file is absent.
const histYears = [y2022, y2023, y2024, y2025] as any[];

const ROOT = path.resolve(process.cwd(), '..');
type Row = { system: string; team?: string; date?: string; scores: Record<string, number> };

// --- 2026: final participant results (repo-root participant_results.json) ---
// Frozen after evaluation closed: global P/R/F1 re-run by the organisers with the
// CodaBench scorer, organiser-side Global Coherence (the same basis as
// baseline_coherence.json), and the local-ranking leaderboard at the close.
type Prf = Record<'f1_repaired' | 'precision_repaired' | 'recall_repaired' | 'f1_standard' | 'precision_standard' | 'recall_standard', number>;
type PairResult = Prf & { coherence: { elk: number | null; hermit?: number | null } };
type GSys = { system: string; team: string; submitted: string; use_train_maps: boolean | null; macro: Prf; pairs: Record<string, PairResult> };
type Rank = Record<'mrr' | 'hits_at_1' | 'hits_at_5' | 'hits_at_10', number>;
type LSys = { system: string; team: string; submitted: string; use_train_maps: boolean | null; macro: Rank; pairs: Record<string, Rank | null> };
type Final = {
  frozen: string;
  global: { pairs: string[]; coherence: { union_class_count: Record<string, number> }; systems: GSys[] };
  local: { systems: LSys[] };
};
const FINAL = path.join(ROOT, 'participant_results.json');
const final: Final | null = fs.existsSync(FINAL) ? JSON.parse(fs.readFileSync(FINAL, 'utf8')) : null;

// --- 2026: live participant results, from the CI-written CodaBench snapshot ---
// Only while the CodaBench sync in .github/workflows/deploy.yml runs and no final file exists.
const LIVE = path.join(ROOT, LIVE_RESULTS_REL);
type Live = { fetched_at?: string; global?: Row[]; local?: Row[] };
const live: Live | null = !final && fs.existsSync(LIVE) ? JSON.parse(fs.readFileSync(LIVE, 'utf8')) : null;

const f3 = (x: number | undefined) => (typeof x === 'number' ? x.toFixed(3) : '—');
// Use Train Maps flag: ✔ / ✘ as in the prior editions' tables; '-' while not yet determined.
const flag = (b: boolean | null | undefined) => (b == null ? '-' : b ? '✔' : '✘');
const day = (d?: string) => (d ? d.slice(0, 10) : '—');
const longDay = (d: string) =>
  new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

// Final results table, one tab per view (Macro, then each pair), in the layout of the
// 2025 tables: both subtracks in one table, joined by system name. A system that did
// not enter a subtrack (or submit a pair) has blank cells there. Rows sort by repaired
// F1; ranking-only systems follow, by MRR. The best repaired F1 and MRR are highlighted.
const REP_KEYS = ['precision_repaired', 'recall_repaired', 'f1_repaired'] as const;
const RANK_KEYS = ['mrr', 'hits_at_1', 'hits_at_5', 'hits_at_10'] as const;
const STD_KEYS = ['precision_standard', 'recall_standard', 'f1_standard'] as const;
const COLS = ['Precision', 'Recall', 'F1', 'MRR', 'H@1', 'H@5', 'H@10', 'Precision', 'Recall', 'F1'];
const GROUP_STARTS = new Set([2, 5, 9]); // first column of Repaired / Ranking / Standard
type Cell = number | null;
type ResultRow = { system: string; useTrainMaps: boolean | null; cells: Cell[] };
const gSystems = final?.global.systems ?? [];
const lSystems = final?.local.systems ?? [];
const systemNames = [...new Set([...gSystems, ...lSystems].map((s) => s.system))];
const rowsFor = (view: string): ResultRow[] =>
  systemNames
    .map((name) => {
      const g = gSystems.find((s) => s.system === name);
      const l = lSystems.find((s) => s.system === name);
      const gm = g ? (view === 'macro' ? g.macro : g.pairs[view]) : null;
      const lm = l ? (view === 'macro' ? l.macro : l.pairs[view]) : null;
      return {
        system: name,
        useTrainMaps: g?.use_train_maps ?? l?.use_train_maps ?? null,
        cells: [...REP_KEYS.map((k) => gm?.[k] ?? null), ...RANK_KEYS.map((k) => lm?.[k] ?? null), ...STD_KEYS.map((k) => gm?.[k] ?? null)],
      };
    })
    .sort((a, b) => (b.cells[2] ?? -1) - (a.cells[2] ?? -1) || (b.cells[3] ?? -1) - (a.cells[3] ?? -1));
const resultTabs = [
  { key: 'macro', label: 'Macro' },
  ...(final?.global.pairs ?? []).map((p) => ({ key: p, label: p.replace('-', '–') })),
].map((t) => {
  const rows = rowsFor(t.key);
  const best = (i: number) => Math.max(...rows.map((r) => r.cells[i] ?? -1));
  return { ...t, rows, bestF1: best(2), bestMrr: best(3) };
});
const c3 = (x: Cell) => (x == null ? '' : x.toFixed(3));

// Coherence table rows: the global systems, in the Macro tab's order.
const finalRows: GSys[] = gSystems.slice().sort((a, b) => b.macro.f1_repaired - a.macro.f1_repaired);

// Global Coherence, per pair as on the baselines page: HermiT only for NCIT–DOID (the
// one pair where the exact reasoner terminates). Not macro-averaged, because some
// systems have a cell ELK could not compute — an average would mix two and three pairs.
const COH_GROUPS: { pair: string; reasoners: ('elk' | 'hermit')[] }[] = [
  { pair: 'NCIT-DOID', reasoners: ['elk', 'hermit'] },
  { pair: 'SNOMED-FMA', reasoners: ['elk'] },
  { pair: 'SNOMED-NCIT', reasoners: ['elk'] },
];
const RLABEL = { elk: 'ELK', hermit: 'HermiT' } as const;
const cohOf = (r: GSys, pair: string, reasoner: 'elk' | 'hermit') => r.pairs[pair]?.coherence?.[reasoner] ?? null;
const cohIncomplete = finalRows.filter((r) => COH_GROUPS.some((g) => g.reasoners.some((rs) => cohOf(r, g.pair, rs) == null))).length;
// "9,474 (4.30%)": the degree is derived from the stored count and denominator, at
// toPrecision(3) so that LogMapLLM's 11 classes do not render as "0.00%" and read as
// coherent (same rule as the baselines page).
const cohCell = (n: number | null, pair: string) => {
  if (n == null) return '—';
  if (n === 0) return '0 (0%)';
  const den = final?.global.coherence.union_class_count[pair] ?? NaN;
  return `${n.toLocaleString('en-GB')} (${((100 * n) / den).toPrecision(3)}%)`;
};
const cohDen = (pair: string) => (final?.global.coherence.union_class_count[pair] ?? 0).toLocaleString('en-GB');

const GLOBAL_COLS = [
  { key: 'macro_f1_repaired', label: 'F1 (repaired)' },
  { key: 'macro_precision_repaired', label: 'P (repaired)' },
  { key: 'macro_recall_repaired', label: 'R (repaired)' },
  { key: 'global_coherence', label: 'Global Coherence' },
];
const LOCAL_COLS = [
  { key: 'macro_mrr', label: 'MRR' },
  { key: 'macro_hits_at_1', label: 'Hits@1' },
  { key: 'macro_hits_at_5', label: 'Hits@5' },
  { key: 'macro_hits_at_10', label: 'Hits@10' },
];
type Col = { key: string; label: string };
type Section = { id: string; kicker: string; cols: Col[]; headline: string; rows: Row[]; portal: string | null };
const sortByHeadline = (rows: Row[], h: string): Row[] =>
  rows.slice().sort((a, b) => (b.scores[h] ?? -Infinity) - (a.scores[h] ?? -Infinity));
const liveGlobal: Section = { id: 'global', kicker: 'Track 1 · Subtrack 1 — global equivalence alignment', cols: GLOBAL_COLS, headline: 'macro_f1_repaired', rows: sortByHeadline(live?.global ?? [], 'macro_f1_repaired'), portal: CODABENCH_GLOBAL_URL };
const localSection: Section = { id: 'local', kicker: 'Track 1 · Subtrack 2 — local equivalence ranking', cols: LOCAL_COLS, headline: 'macro_mrr', rows: sortByHeadline(live?.local ?? [], 'macro_mrr'), portal: CODABENCH_LOCAL_URL };
const sections: Section[] = [liveGlobal, localSection];
const comps = [
  { name: 'Track 1 · Subtrack 1 — Global equivalence alignment', url: CODABENCH_GLOBAL_URL },
  { name: 'Track 1 · Subtrack 2 — Local equivalence ranking', url: CODABENCH_LOCAL_URL },
];

const tabYears = [...histYears.map((y) => y.year), 2026];
---

<Base
  title="Results"
  description="OAEI Bio-ML results by edition: the final 2026 results (global alignment with Global Coherence, and local ranking) and the prior editions 2022–2025, each shown in its original structure."
>
  <div class="page-head">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={withBase('/')}>Home</a><span class="sep" aria-hidden="true">/</span><span aria-current="page">Results</span>
      </nav>
      <h1>Results</h1>
      <p class="lead">
        The current 2026 edition and every prior OAEI Bio-ML campaign. Use the year tabs to switch editions.
        Prior editions kept a different pair set and evaluation setup, so each is shown in its own structure;
        the 2026 organiser baselines live on the <a href={withBase('/baselines/')}>baselines page</a>.
      </p>
    </div>
  </div>

  <section class="section" style="border-top:none; padding-top:1rem;">
    <div class="container">
      <div class="year-tabs" role="tablist" aria-label="Results by year">
        {tabYears.map((yr) => (
          <button
            class="year-tab"
            id={`ytab-${yr}`}
            role="tab"
            data-year={yr}
            aria-controls={`year-${yr}`}
            aria-selected={yr === 2026 ? 'true' : 'false'}
            tabindex={yr === 2026 ? '0' : '-1'}
          >{yr}{yr === 2026 && <span class="cur">current</span>}</button>
        ))}
      </div>

      {/* -------- Prior editions -------- */}
      {histYears.map((y) => (
        <div class="year-panel" id={`year-${y.year}`} role="tabpanel" aria-labelledby={`ytab-${y.year}`} tabindex="0" hidden>
          <p class="year-meta">{y.settings} Source: <a href={y.sourceUrl}>{y.host}</a>.</p>
          <div class="pair-tabs" role="tablist" aria-label={`${y.year} pairs`}>
            {y.pairs.map((p: any, pi: number) => (
              <button class="pair-tab" role="tab" id={`ptab-${y.year}-${p.pair}`}
                      data-panel={`pp-${y.year}-${p.pair}`} aria-controls={`pp-${y.year}-${p.pair}`}
                      aria-selected={pi === 0 ? 'true' : 'false'} tabindex={pi === 0 ? '0' : '-1'}>{p.label}</button>
            ))}
          </div>
          {y.pairs.map((p: any, pi: number) => (
            <div class="pair-panel" id={`pp-${y.year}-${p.pair}`} role="tabpanel" aria-labelledby={`ptab-${y.year}-${p.pair}`} hidden={pi !== 0}>
              {p.tables.equiv && (
                <>
                  <h3 class="match-h">Equivalence matching<span class="rel rel-eq"><code>=</code></span></h3>
                  <HistTable table={p.tables.equiv} />
                </>
              )}
              {p.tables.subs && (
                <>
                  <h3 class="match-h">Subsumption matching<span class="rel rel-sub"><code>&lt; &gt;</code></span></h3>
                  <HistTable table={p.tables.subs} />
                </>
              )}
            </div>
          ))}
          <p class="hist-note">
            Published OAEI Bio-ML {y.year} results, transcribed from the campaign result pages. Footnote marks
            (∗ † ‡) and the “Use Train(ing) Maps” flag are those of the original tables. Blank cells were not
            reported. Authoritative copy: <a href={y.sourceUrl}>{y.host}</a>.
          </p>
        </div>
      ))}

      {/* -------- 2026 (current edition) -------- */}
      <div class="year-panel" id="year-2026" role="tabpanel" aria-labelledby="ytab-2026" tabindex="0">
        <div class="notice" style="margin-top:0;">
          <span aria-hidden="true">ℹ</span>
          <span>
            <strong>The system review has been completed.</strong> The results below will be considered
            <em>final</em> after 6 October 2026. Review terms:
            <a href={`${GITHUB_REPO}#submissions-system-review`}>Submissions (System Review)</a>.
          </span>
        </div>

        {!final && !live && (
          <>
            <h2 style="margin-top:0.4rem;">No participant submissions yet</h2>
            <p class="section-lede">
              The 2026 competition and leaderboards opened on <strong>12 July 2026</strong>; evaluation closes on
              30 September 2026 and the competition ends on 6 October 2026. Submitted systems and their scores
              appear here — updated automatically from the live CodaBench leaderboards — as submissions are scored.
              Meanwhile, see the organiser <a href={withBase('/baselines/')}>baselines</a>.
            </p>
            <div class="notice">
              <span aria-hidden="true">ℹ</span>
              <span>
                Submit via CodaBench:
                {comps.map((c, i) => (
                  <>{i > 0 && ' · '}{c.url ? <a href={c.url}>{c.name}</a> : <span>{c.name} (to be announced)</span>}</>
                ))}. To prepare, work through the <a href={withBase('/quickstart/')}>quickstart</a> and validate
                your files with the scoring-kit scripts.
              </span>
            </div>
          </>
        )}

        {final && (
          <>
            <section aria-labelledby="systems-h" style="margin-top:1.6rem;">
              <p class="kicker">Track 1 · Subtracks 1 and 2</p>
              <h2 id="systems-h">Submitted systems</h2>
              <div class="pair-tabs" role="tablist" aria-label="Macro average or ontology pair">
                {resultTabs.map((t, ti) => (
                  <button class="pair-tab" role="tab" id={`ptab-2026-${t.key}`}
                          data-panel={`pp-2026-${t.key}`} aria-controls={`pp-2026-${t.key}`}
                          aria-selected={ti === 0 ? 'true' : 'false'} tabindex={ti === 0 ? '0' : '-1'}>{t.label}</button>
                ))}
              </div>
              {resultTabs.map((t, ti) => (
                <div class="pair-panel" id={`pp-2026-${t.key}`} role="tabpanel" aria-labelledby={`ptab-2026-${t.key}`} hidden={ti !== 0}>
                  <div class="table-wrap">
                    <table class="hist-table" aria-label={`2026 results: ${t.label}`}>
                      <thead>
                        <tr>
                          <td colspan="2"></td>
                          <th class="grp" colspan="3" scope="colgroup">Repaired</th>
                          <th class="grp" colspan="4" scope="colgroup">Ranking</th>
                          <th class="grp" colspan="3" scope="colgroup">Standard (unrepaired)</th>
                        </tr>
                        <tr>
                          <th scope="col">System</th>
                          <th scope="col">Use Train Maps</th>
                          {COLS.map((c, ci) => (
                            <th scope="col" class={GROUP_STARTS.has(ci + 2) ? 'grp' : undefined}>{c}</th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {t.rows.map((r) => (
                          <tr>
                            <td>{r.system}</td>
                            <td>{flag(r.useTrainMaps)}</td>
                            {r.cells.map((x, ci) => (
                              <td class={GROUP_STARTS.has(ci + 2) ? 'grp' : undefined}>
                                {x != null && ((ci === 2 && x === t.bestF1) || (ci === 3 && x === t.bestMrr))
                                  ? <span class="best">{c3(x)}</span>
                                  : c3(x)}
                              </td>
                            ))}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>
              ))}
              <p class="rt-note">
                Repaired and Standard: global alignment, scored against the repaired (headline) and the standard
                reference. Ranking: local equivalence ranking. Macro: the unweighted mean over the three pairs.
                A blank cell means not submitted. See <a href={withBase('/evaluation/')}>evaluation metrics</a>.
              </p>
            </section>

            <section aria-labelledby="global-coherence" style="margin-top:2.4rem;">
              <p class="kicker">Track 1 · Subtrack 1</p>
              <h2 id="global-coherence">Systems coherence</h2>
              <p class="rt-sub">
                Each submitted alignment is also checked with a reasoner: does the system's <strong>own</strong>
                alignment leave the merged ontology satisfiable? Each cell gives the number of unsatisfiable named
                classes and, in parentheses, the incoherence degree (that count over the counted named classes).
                <strong>Lower is better; 0 is coherent.</strong> Reported per pair rather than macro-averaged,
                because {cohIncomplete} systems have a cell that could not be computed. Rows follow the table above.
              </p>
              <div class="table-wrap">
                <table>
                  <thead>
                    <tr>
                      <th rowspan="2" scope="col">System</th>
                      {COH_GROUPS.map((g) => (
                        <th class="num" colspan={g.reasoners.length} scope="colgroup">{g.pair.replace('-', '–')}</th>
                      ))}
                    </tr>
                    <tr>
                      {COH_GROUPS.flatMap((g) => g.reasoners.map((rs) => (
                        <th class="num" scope="col">{RLABEL[rs]}</th>
                      )))}
                    </tr>
                  </thead>
                  <tbody>
                    {finalRows.map((r) => (
                      <tr>
                        <td>{r.system}</td>
                        {COH_GROUPS.flatMap((g) => g.reasoners.map((rs) => (
                          <td class="num">{cohCell(cohOf(r, g.pair, rs), g.pair)}</td>
                        )))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <p class="rt-note">
                Computed organiser-side on each system's whole submitted alignment <span class="mono">M</span>, not
                only the test slice, merged with both ontologies
                (<span class="mono">O<sub>src</sub> ∪ O<sub>tgt</sub> ∪ M</span>, each correspondence asserted as an
                equivalence). Every <strong>ELK</strong> figure is a sound lower bound; <strong>HermiT</strong> is
                exact but is run on NCIT–DOID only. — means ELK exhausted a 384 GB heap, so the value is unknown.
                The conventions are those of the
                <a href={withBase('/baselines/#baseline-coherence')}>baseline coherence table</a>.
                Coherence is <strong>not</strong> a quality ranking and does not track F1.
              </p>
            </section>

            <section aria-labelledby="resources-h" style="margin-top:2.4rem;">
              <p class="kicker">Track 1 · Subtracks 1 and 2</p>
              <h2 id="resources-h">Resource use and wall-clock time</h2>
              <div class="notice" style="margin-top:0.4rem;">
                <span aria-hidden="true">ℹ</span>
                <span>We are waiting on further correspondence from participants before publishing this table.</span>
              </div>
            </section>

            <p style="font-size:0.85rem; color:var(--ink-3); max-width:76ch; margin-top:1.8rem;">
              Final results, frozen on {longDay(final.frozen)}. All scores were computed by the organisers with the
              unmodified CodaBench scoring programs and reproduce the CodaBench leaderboards. Data:
              <a class="mono" href={withBase('/participant_results.json')}>participant_results.json</a>.
            </p>
          </>
        )}

        {live && sections.map((s) => (
          <section aria-labelledby={`${s.id}-h`} style="margin-top:1.6rem;">
            <p class="kicker">{s.kicker}</p>
            <h2 id={`${s.id}-h`}>Submitted systems</h2>
            <div class="table-wrap">
              <table class="sortable">
                <thead>
                  <tr>
                    <th>#</th><th>System</th><th>Team</th>
                    {s.cols.map((c) => <th class="num">{c.label}</th>)}
                    <th>Submitted</th>
                  </tr>
                </thead>
                <tbody>
                  {s.rows.map((r, i) => (
                    <tr>
                      <td class="num">{i + 1}</td>
                      <td>{r.system}</td>
                      <td>{r.team ?? '—'}</td>
                      {s.cols.map((c, ci) => (
                        <td class="num">{ci === 0 && i === 0 ? <span class="best">{f3(r.scores[c.key])}</span> : f3(r.scores[c.key])}</td>
                      ))}
                      <td>{day(r.date)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            {s.rows.length === 0 && <p>No submissions to this competition yet.</p>}
          </section>
        ))}

        {live && (
          <p style="font-size:0.85rem; color:var(--ink-3); max-width:76ch; margin-top:1.4rem;">
            Snapshot taken {live.fetched_at ? day(live.fetched_at) : 'recently'} from the two CodaBench
            leaderboards; the site republishes on a schedule, so very recent submissions may not appear yet. All
            columns are macro-averaged over the three pairs (NCIT–DOID, SNOMED–FMA, SNOMED–NCIT). Global
            alignment sorts by repaired coherence-aware F1; local by MRR. See
            <a href={withBase('/evaluation/')}> evaluation metrics</a>. Columns sort on click.
          </p>
        )}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="how-h">
    <div class="container">
      <p class="kicker">Participate</p>
      <h2 id="how-h">How to submit (2026)</h2>
      <p class="section-lede">
        Work through the <a href={withBase('/quickstart/')}>quickstart</a>: download the data from the Hugging
        Face dataset, produce one alignment RDF per pair (global) and/or one ranking submission per pair (local),
        validate with the scoring-kit scripts, and submit via CodaBench.
      </p>
      <ul>
        {comps.map((c) => (
          <li>{c.url ? <a href={c.url}>{c.name}</a> : <span>{c.name} — <em>to be announced</em></span>}</li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<script>
  // Year tabs + nested pair tabs. Roving tabindex + arrow-key support.
  function wireTablist(list: HTMLElement, onSelect: (tab: HTMLElement) => void) {
    const tabs = Array.from(list.querySelectorAll<HTMLElement>('[role="tab"]'));
    const select = (tab: HTMLElement, focus = true) => {
      tabs.forEach((t) => { t.setAttribute('aria-selected', String(t === tab)); t.tabIndex = t === tab ? 0 : -1; });
      if (focus) tab.focus();
      onSelect(tab);
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab, false));
      tab.addEventListener('keydown', (e) => {
        let j = -1;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') j = (i + 1) % tabs.length;
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') j = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') j = 0;
        else if (e.key === 'End') j = tabs.length - 1;
        if (j >= 0) { e.preventDefault(); select(tabs[j]); }
      });
    });
  }

  // year-level
  const yearList = document.querySelector<HTMLElement>('.year-tabs');
  if (yearList) {
    wireTablist(yearList, (tab) => {
      const yr = tab.getAttribute('data-year');
      document.querySelectorAll<HTMLElement>('.year-panel').forEach((p) => {
        p.hidden = p.id !== `year-${yr}`;
      });
    });
  }
  // pair-level (one tablist per historical year)
  document.querySelectorAll<HTMLElement>('.pair-tabs').forEach((list) => {
    wireTablist(list, (tab) => {
      const target = tab.getAttribute('data-panel');
      const scope = list.closest('.year-panel');
      scope?.querySelectorAll<HTMLElement>('.pair-panel').forEach((p) => { p.hidden = p.id !== target; });
    });
  });
</script>
